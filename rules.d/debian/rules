#!/usr/bin/make -f
# Debian packaging for gsp670-linux. See rules.d/README.md.

export DH_VERBOSE = 1

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_build:
	python3 -m build --wheel --no-isolation

override_dh_auto_install:
	python3 -m build --wheel --no-isolation -o dist
	# Ship the runtime rules and units alongside the Python package.
	install -D -m 0644 udev/99-gsp670.rules \
		debian/gsp670/usr/lib/udev/rules.d/99-gsp670.rules
	install -D -m 0644 udev/99-gsp670-audio.rules \
		debian/gsp670/usr/lib/udev/rules.d/99-gsp670-audio.rules
	install -D -m 0755 scripts/gsp670-audio-guard.sh \
		debian/gsp670/usr/lib/gsp670/gsp670-audio-guard.sh
	install -D -m 0644 systemd/gsp670-audio-guard.service \
		debian/gsp670/usr/lib/systemd/system/gsp670-audio-guard.service
	install -D -m 0644 contrib/wireplumber/50-gsp670.conf \
		debian/gsp670/usr/share/wireplumber/wireplumber.conf.d/50-gsp670.conf
	install -D -m 0644 contrib/pipewire/gsp670-virtual-surround-7.1.conf \
		debian/gsp670/usr/share/pipewire/pipewire.conf.d/50-gsp670-surround.conf

override_dh_auto_test:
	# The hardware test needs a physically connected device; skip it here.
	pytest -q tests/unit tests/integration

# The audio guard is useful but should be opt-in for package users.
override_dh_installsystemd:
	dh_installsystemd --name=gsp670 --no-enable --no-start
